-- Everything passed on here with `export from` is the public surface of `UIKit`.
--
-- One line per file, grouped by layer, in dependency order — values, then the
-- framework, then the views built on top of it.
--
-- Implementation files import each other by explicit path
-- (`from core.Geometry import *`); nothing imports a folder. That keeps every
-- file's dependencies readable at file granularity, which is what stops the
-- layering below from quietly turning into a cycle.

-- Values. Nothing here knows the view tree exists.
export from core.Geometry import *
export from core.Color import *
export from core.TextStyle import *
export from core.ThemeData import *
export from core.Assets import *
export from core.Tween import *
export from core.Events import *
export from core.Input import *
export from core.ZStackData import *
export from core.Date import *

-- The two-tree kernel, and the per-frame bookkeeping around it.
export from framework.Diagnostics import *
export from framework.Framework import *

-- Layout.
export from layout.Boxes import *
export from layout.Stacks import *
export from layout.ZStack import *

-- The ambient theme, read by every control below.
export from Theme import *

-- Painting.
export from painting.Paint import *
export from painting.Canvas import *
export from painting.Images import *
export from painting.Image import *
export from painting.Icon import *
export from painting.Shortcut import *

-- Input and motion.
export from gestures.Gesture import *
export from animation.Animation import *

-- Overlays. `Manager` installs the implementation the kernel calls through,
-- so it comes before the layers built on it.
export from overlays.Manager import *
export from overlays.Barrier import *
export from overlays.Dialog import *
export from overlays.Menu import *
export from overlays.Tooltip import *
export from overlays.Toast import *

-- Scrolling.
export from scrolling.Controller import *
export from scrolling.ScrollBar import *
export from scrolling.ScrollView import *

-- Text: the engine and line mapping first, then the widgets over them.
export from text.LineMap import *
export from text.TextEngine import *
export from text.TextField import *
export from text.TextEditor import *

-- Controls.
export from controls.Support import *
export from controls.Activatable import *
export from controls.Button import *
export from controls.Checkbox import *
export from controls.Radio import *
export from controls.Toggle import *
export from controls.Slider import *
export from controls.Progress import *
export from controls.Picker import *
export from controls.Tabs import *
export from controls.DateField import *

-- Data views and page structure.
export from data.Grid import *
export from data.Table import *
export from shell.Shell import *

-- Last before the entry point: it names every view above to implement
-- `View`'s modifiers, and installs itself as it loads.
export from Modifiers import *

-- The entry point sits on top of everything, `runApp` included.
export from app.Runtime import *
export from app.App import *
