from shine import Graphics, Font
from core.Color import *
from core.Geometry import *

-- Split on a single-character separator. `String.find` gives the next
-- occurrence; everything between the cursors is one piece, including empty
-- ones, so a blank line survives wrapping.
export fn splitOn(text: string, separator: string) -> table<string>
	local out: table<string> = {}
	local cursor: integer = 1
	local scanning: boolean = true

	while scanning do
		local start: integer?, stop: integer? = String.find(text, separator, cursor)

		if start == nil then
			scanning = false
		else
			out[#out + 1] = String.sub(text, cursor, start! - 1)
			cursor = start! + String.len(separator)
		end
	end

	out[#out + 1] = String.sub(text, cursor)

	return out
end

-- A letter or a digit, of the plain Latin kind: what a hyphen sits between
-- when a line may break after it.
local fn isWordChar(ch: string) -> boolean
	return (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9")
end

-- A word in the pieces a line may break between: after each hyphen inside
-- it, as "well-" "known", or a kernel's "6.18.58-" "microsoft-" "standard".
-- Only between letters or digits, so "-5" keeps its sign and "--" stays
-- whole. A word without such a hyphen is one piece.
export fn hyphenPieces(word: string) -> table<string>
	local out: table<string> = {}
	local length: integer = String.len(word)
	local start: integer = 1

	for i: integer = 2, length - 1 do
		local before: string = String.sub(word, i - 1, i - 1)
		local after: string = String.sub(word, i + 1, i + 1)

		if String.sub(word, i, i) == "-" and isWordChar(before) and isWordChar(after) then
			out[#out + 1] = String.sub(word, start, i)
			start = i + 1
		end
	end

	out[#out + 1] = String.sub(word, start)

	return out
end

-- How a `Text` view is drawn, plus the measurement the layout pass needs.
--
-- Fonts are a global, handle-based resource in the engine, so styles share a
-- process-wide cache keyed by size: asking for the same size twice reuses the
-- same handle instead of allocating a new atlas every frame.
export class TextStyle
	color: Color
	size: float?

	-- A typeface of its own: a font file's path, or nil for the system's.
	-- `TextStyle.fixedFace()` finds one whose characters are all one
	-- width, for code and for columns that must line up.
	face: string?

	static local fonts: table<string, Font> = {}

	-- Where systems keep a fixed-width face, in the order tried.
	static local fixedFaces: table<string> = {
		"/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
		"/usr/share/fonts/TTF/DejaVuSansMono.ttf",
		"/usr/share/fonts/dejavu/DejaVuSansMono.ttf",
		"/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf",
		"/usr/share/fonts/liberation-mono/LiberationMono-Regular.ttf",
		"/usr/share/fonts/truetype/ubuntu/UbuntuMono-R.ttf",
		"/System/Library/Fonts/Monaco.ttf",
		"/System/Library/Fonts/Supplemental/Courier New.ttf",
		"C:\\Windows\\Fonts\\consola.ttf",
		"C:\\Windows\\Fonts\\cour.ttf"
	}

	static local fixedFound: boolean = false
	static local fixedPath: string? = nil

	fn init(color: Color? = nil, size: float? = nil, face: string? = nil)
		self.color = color ?? Colors.text
		self.size = size
		self.face = face
	end

	fn withColor(color: Color) -> TextStyle
		return TextStyle(color, self.size, self.face)
	end

	fn withSize(size: float) -> TextStyle
		return TextStyle(self.color, size, self.face)
	end

	fn withFace(face: string?) -> TextStyle
		return TextStyle(self.color, self.size, face)
	end

	-- The path of a fixed-width face this system has, or nil when it has
	-- none of those known: looked for once.
	static fn fixedFace() -> string?
		if not TextStyle.fixedFound then
			TextStyle.fixedFound = true

			for path: string in TextStyle.fixedFaces do
				if TextStyle.fixedPath == nil and Os.exists(path) then
					TextStyle.fixedPath = path
				end
			end
		end

		return TextStyle.fixedPath
	end

	-- Bind the font this style asks for.
	--
	-- A style with no size binds the engine's default face. It has to
	-- bind *something*: fonts are global state, so leaving whatever the last
	-- style set would make a view's measured size depend on the order the
	-- tree happened to be walked in.
	fn applyFont() -> nil
		local size: float? = self.size
		local scale: float = Display.scale()

		if size == nil then
			-- The default face has no size to scale, so a scaled display gets
			-- the same glyphs magnified by the root transform. Give a size to
			-- any text that needs to stay sharp.
			Graphics.setFont()

			return
		end

		-- Rasterize at the *physical* size: a glyph built at 13px and then
		-- magnified by the root transform is blurry, and type is the one thing
		-- that shows it immediately.
		local physical: float = size! * scale
		local face: string? = self.face
		local key: string = String.format("%.2f", physical) .. (face ?? "")
		local cached = fonts[key]

		if cached == nil then
			local created: Font = Graphics.newFont(physical)

			if face != nil then
				-- A face that can't be loaded is the system's instead:
				-- text in the wrong typeface, not none.
				try
					created = Graphics.newFont(physical, face!)
				catch e: string
					created = Graphics.newFont(physical)
				end
			end

			fonts[key] = created
			Graphics.setFont(created)
		else
			Graphics.setFont(cached!)
		end
	end

	-- Font *and* colour — what `paint` wants.
	fn apply() -> nil
		self.applyFont()
		self.color.apply()
	end

	-- Intrinsic size of `text` in this style. Requires a live window: the
	-- engine measures against the real font atlas.
	-- Size of `text` in *logical* units — the space layout should reserve.
	--
	-- The font is physical, so the raw measurement is divided back down. That
	-- keeps every layout calculation in one coordinate system.
	fn measure(text: string) -> Size
		self.applyFont()

		local scale: float = self.fontScale()

		return Size(Graphics.getTextWidth(text) / scale, Graphics.getFontHeight() / scale)
	end

	-- Height of one line, independent of the text in it.
	fn lineHeight() -> float
		self.applyFont()

		return Graphics.getFontHeight() / self.fontScale()
	end

	-- The factor the bound font was built at. The default face is never
	-- rebuilt, so it measures 1:1 and is magnified by the root transform.
	local fn fontScale() -> float
		if self.size == nil then
			return 1.0
		end

		return Display.scale()
	end

	-- Draw `text` with its top-left at the logical point `x, y`.
	--
	-- Every text-drawing view goes through here rather than calling
	-- `Graphics.print` itself. On a scaled display the glyphs are already
	-- physical, so this maps the anchor into device space and draws with the
	-- transform reset — `transformPoint` rather than a multiply, so it stays
	-- correct inside a translated or nested transform too.
	fn draw(text: string, x: float, y: float) -> nil
		self.apply()

		if self.fontScale() == 1.0 then
			Graphics.print(text, x, y)

			return
		end

		local px: float, py: float = Graphics.transformPoint(x, y)

		Graphics.push()
		Graphics.origin()
		Graphics.print(text, px, py)
		Graphics.pop()
	end

	-- Split `text` into lines that each fit within `maxWidth`.
	--
	-- Explicit newlines always break. Within a paragraph the break is greedy and
	-- on spaces, or after a hyphen inside a word ("standard-" "WSL2"), which is
	-- what a UI wants — no hyphenation, no justification. A single word wider
	-- than `maxWidth` with no hyphen to break at is left to overflow rather than
	-- being chopped mid-word, since that reads worse than a clipped edge.
	fn wrap(text: string, maxWidth: float) -> table<string>
		local out: table<string> = {}

		for paragraph: string in splitOn(text, "\n") do
			self.wrapParagraph(paragraph, maxWidth, out)
		end

		if #out == 0 then
			out[1] = ""
		end

		return out
	end

	local fn wrapParagraph(paragraph: string, maxWidth: float, out: table<string>) -> nil
		if #paragraph == 0 then
			out[#out + 1] = ""

			return
		end

		if self.measure(paragraph).width <= maxWidth then
			out[#out + 1] = paragraph

			return
		end

		local line: string = ""

		for word: string in splitOn(paragraph, " ") do
			-- A word's pieces join without a space, words with one.
			local joint: string = " "

			for piece: string in hyphenPieces(word) do
				local candidate: string = piece

				if #line > 0 then
					candidate = line .. joint .. piece
				end

				if self.measure(candidate).width <= maxWidth then
					line = candidate
				else
					if #line > 0 then
						out[#out + 1] = line
					end

					line = piece
				end

				joint = ""
			end
		end

		if #line > 0 then
			out[#out + 1] = line
		end
	end

	-- Where each visual line *starts*, as a 1-based index into `text`.
	--
	-- The editing counterpart to `wrap`. Returning indices rather than strings
	-- is the whole point: an editor has to map a caret position to a line and
	-- back, and re-joined strings lose that correspondence the moment the text
	-- contains a double space or a break that swallowed one.
	--
	-- The first entry is always 1, so the result is never empty.
	fn wrapIndices(text: string, maxWidth: float, softWrap: boolean = true) -> table<integer>
		if String.len(text) == 0 then
			return {1}
		end

		-- Shine walks the text once, adding each character's width to the
		-- line's: measuring the line so far for every character, from
		-- here, is a call into Shine a character, and seconds for a page
		-- of text on a slow machine.
		self.applyFont()

		local limit: float = maxWidth

		if maxWidth < Math.huge then
			limit = maxWidth * self.fontScale()
		end

		return Graphics.getWrapStarts(text, limit, softWrap)
	end

	-- The caret index closest to `x` pixels into `text` — what a click on a text
	-- field resolves to. Walks the prefixes and picks the nearest boundary, so
	-- clicking the right half of a character lands after it.
	fn indexAt(text: string, x: float) -> integer
		local length: integer = String.len(text)

		if x <= 0.0 or length == 0 then
			return 0
		end

		local previous: float = 0.0
		local i: integer = 1

		while i <= length do
			local width: float = self.measure(String.sub(text, 1, i)).width

			if width >= x then
				if x - previous < width - x then
					return i - 1
				end

				return i
			end

			previous = width
			i = i + 1
		end

		return length
	end
end
