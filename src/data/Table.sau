from shine import *
from core.Geometry import *
from core.Color import *
from core.TextStyle import *
from core.ThemeData import *
from core.Input import *
from framework.Framework import *
from Theme import *
from gestures.Gesture import *
from layout.Boxes import *
from layout.Stacks import *
from painting.Icon import *
from painting.Paint import *

-- ============================================================================
-- Table
-- ============================================================================
--
-- Columns line up across rows because every row is built from the same width
-- rules, so alignment is structural rather than something layout keeps in
-- sync. Sorting is reported, not performed.

-- ----------------------------------------------------------------------------
-- Table
-- ----------------------------------------------------------------------------

export enum SortOrder
	None,
	Ascending,
	Descending
end

-- One column: a heading, a width rule, and whether it can be sorted.
--
-- A `width` pins the column; leaving it out shares the remaining space by
-- `flex`, so a table of "id, name, date" can pin the narrow ones and let the
-- name take what is left.
export class TableColumn
	title: string
	width: float?
	flex: integer
	align: Alignment
	sortable: boolean

	fn init(
		title: string = "",
		width: float? = nil,
		flex: integer = 1,
		align: Alignment? = nil,
		sortable: boolean = false
	)
		self.title = title
		self.width = width
		self.flex = flex
		self.align = align ?? Alignment.centerLeft()
		self.sortable = sortable
	end
end

-- One row of cells. `key` is worth setting on anything sortable or filterable:
-- it is what carries a row's element — and any state inside it — when the order
-- changes.
export class TableRow
	cells: table<View>
	key: string?
	onTap: (fn() -> nil)?

	fn init(cells: table<View> = {}, key: string? = nil, onTap: (fn() -> nil)? = nil)
		self.cells = claimedAll(cells)
		self.key = key
		self.onTap = onTap
	end
end

-- A table with aligned columns, a sortable header and striped rows.
--
--     TableView(
--         columns: {
--             TableColumn("Name", sortable: true),
--             TableColumn("Size", width: 90.0, align: Alignment.centerRight())
--         },
--         rows: rows,
--         sortColumn: 1,
--         sortOrder: SortOrder.Ascending,
--         onSort: fn(column: integer, order: SortOrder) ... end
--     )
--
-- Sorting is *reported*, not performed: the table draws the order you give it
-- and tells you which header was clicked, so the data stays yours.
export class TableView extends View
	columns: table<TableColumn>
	rows: table<TableRow>

	sortColumn: integer
	sortOrder: SortOrder
	onSort: (fn(integer, SortOrder) -> nil)?

	striped: boolean
	rowPadding: EdgeInsets?

	fn init(
		columns: table<TableColumn> = {},
		rows: table<TableRow> = {},
		sortColumn: integer = 0,
		sortOrder: SortOrder = SortOrder.None,
		onSort: (fn(integer, SortOrder) -> nil)? = nil,
		striped: boolean = true,
		rowPadding: EdgeInsets? = nil,
		key: string? = nil
	)
		self.super(key)

		self.columns = columns
		self.rows = rows
		self.sortColumn = sortColumn
		self.sortOrder = sortOrder
		self.onSort = onSort
		self.striped = striped
		self.rowPadding = rowPadding
	end

	-- Wrap one cell in the width rule its column declares. Both branches produce
	-- a view the flex layout sizes, which is what keeps the columns aligned.
	local fn sized(column: TableColumn, child: View) -> View
		local width: float? = column.width

		if width != nil then
			return Frame(width: width!, child: child)
		end

		return child.expanded(column.flex)
	end

	local fn cellInsets() -> EdgeInsets
		return self.rowPadding ?? EdgeInsets.symmetric(horizontal: 10.0, vertical: 7.0)
	end

	fn body(context: BuildContext) -> View
		local theme: ThemeData = Theme.of(context)
		local out: table<View> = {self.header(context, theme)}
		local i: integer = 1

		while i <= #self.rows do
			out[#out + 1] = TableRowView(
				row: self.rows[i],
				columns: self.columns,
				padding: self.cellInsets(),
				striped: self.striped and i % 2 == 0,
				key: self.rows[i].key
			)

			i = i + 1
		end

		return VStack(alignment: StackAlignment.Fill, sizing: StackSize.Fit, children: out)
	end

	local fn header(context: BuildContext, theme: ThemeData) -> View
		local cells: table<View> = {}
		local i: integer = 1

		while i <= #self.columns do
			local column: TableColumn = self.columns[i]
			local at: integer = i

			cells[#cells + 1] = self.sized(
				column,
				TableHeaderCell(
					column: column,
					order: self.orderFor(i),
					theme: theme,
					onTap: fn()
						self.sortBy(at)
					end
				)
			)

			i = i + 1
		end

		return VStack(
			alignment: StackAlignment.Fill,
			sizing: StackSize.Fit,
			children: {
				Box(
					color: theme.surfaceLight,
					padding: self.cellInsets(),
					child: HStack(alignment: StackAlignment.Center, children: cells)
				),
				Box(height: 1.0, color: theme.border),
			}
		)
	end

	local fn orderFor(column: integer) -> SortOrder
		if column != self.sortColumn then
			return SortOrder.None
		end

		return self.sortOrder
	end

	-- Clicking the sorted column flips it; clicking another starts ascending.
	local fn sortBy(column: integer) -> nil
		local callback: (fn(integer, SortOrder) -> nil)? = self.onSort

		if callback == nil or column < 1 or column > #self.columns then
			return
		end

		if not self.columns[column].sortable then
			return
		end

		local next: SortOrder = SortOrder.Ascending

		if column == self.sortColumn and self.sortOrder == SortOrder.Ascending then
			next = SortOrder.Descending
		end

		callback!(column, next)
	end
end

-- A header cell: the title, plus an arrow when it is the sorted column.
export class TableHeaderCell extends View
	column: TableColumn
	order: SortOrder
	theme: ThemeData
	onTap: (fn() -> nil)?

	fn init(
		column: TableColumn,
		order: SortOrder = SortOrder.None,
		theme: ThemeData? = nil,
		onTap: (fn() -> nil)? = nil,
		key: string? = nil
	)
		self.super(key)

		self.column = column
		self.order = order
		self.theme = theme ?? ThemeData()
		self.onTap = onTap
	end

	fn body(context: BuildContext) -> View
		local scratch: ElementData = context.data()
		local hovered: boolean = scratch.hovered == true

		local ink: Color = self.theme.textMuted

		if self.order != SortOrder.None or hovered and self.column.sortable then
			ink = self.theme.text
		end

		local label: View = Text(
			self.column.title,
			style: TextStyle(color: ink),
			softWrap: false,
			maxLines: 1
		)

		if self.order != SortOrder.None then
			local arrow: integer = Icons.arrowUpward

			if self.order == SortOrder.Descending then
				arrow = Icons.arrowDownward
			end

			label = HStack(sizing: StackSize.Fit, spacing: 4.0, children: {label, Icon(arrow, 14.0, ink)})
		end

		local cell: View = label.aligned(self.column.align)

		if not self.column.sortable then
			return cell
		end

		return GestureArea(
			child: cell,
			onTap: self.onTap,
			onHover: fn(inside: boolean)
				scratch.hovered = inside
				context.markNeedsBuild()
			end
		)
	end
end

-- One data row: striped, hover-highlighted, and tappable when the row says so.
export class TableRowView extends View
	row: TableRow
	columns: table<TableColumn>
	padding: EdgeInsets
	striped: boolean

	fn init(
		row: TableRow,
		columns: table<TableColumn> = {},
		padding: EdgeInsets? = nil,
		striped: boolean = false,
		key: string? = nil
	)
		self.super(key)

		self.row = row
		self.columns = columns
		self.padding = padding ?? EdgeInsets.symmetric(horizontal: 10.0, vertical: 7.0)
		self.striped = striped
	end

	fn body(context: BuildContext) -> View
		local theme: ThemeData = Theme.of(context)
		local scratch: ElementData = context.data()
		local hovered: boolean = scratch.hovered == true

		local fill: Color? = nil

		if self.striped then
			fill = theme.surfaceLight.withAlpha(0.4)
		end

		if hovered and self.row.onTap != nil then
			fill = theme.surfaceLight
		end

		local cells: table<View> = {}
		local i: integer = 1

		while i <= #self.columns do
			local column: TableColumn = self.columns[i]
			local content: View = Frame()

			if i <= #self.row.cells then
				content = self.row.cells[i]
			end

			local aligned: View = content.aligned(column.align)
			local width: float? = column.width

			if width != nil then
				cells[#cells + 1] = aligned.frame(width: width!)
			else
				cells[#cells + 1] = aligned.expanded(column.flex)
			end

			i = i + 1
		end

		local inner: View = Box(
			color: fill,
			padding: self.padding,
			child: HStack(alignment: StackAlignment.Center, children: cells)
		)

		if self.row.onTap == nil then
			return inner
		end

		return GestureArea(
			child: inner,
			onTap: self.row.onTap,
			onHover: fn(inside: boolean)
				scratch.hovered = inside
				context.markNeedsBuild()
			end
		)
	end
end
